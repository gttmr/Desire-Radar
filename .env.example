# =============================================================================
# Discord Bot
# =============================================================================
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DEFAULT_TEXT_CHANNEL_ID=
ACTION_TTL_SEC=600
HEALTH_PORT=3000
STT_PROVIDER=mock
CONFIG_STORE_PATH=data/guild-report-config.json
REPORT_TIME_KST=08:00
REPORT_TIMEZONE=Asia/Seoul

# Analysis backend: 'predictor' (legacy) or 'orchestrator' (new MCP)
ANALYSIS_BACKEND=predictor
PREDICTOR_BASE_URL=http://predictor-legacy:5001
COLLECTOR_BASE_URL=http://collector:5002
ORCHESTRATOR_BASE_URL=http://mcp-orchestrator:5003

# =============================================================================
# Predictor Legacy
# =============================================================================
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
FRED_API_KEY=
KOBIS_API_KEY=
EIA_API_KEY=

# =============================================================================
# Collector
# =============================================================================
COLLECTOR_PORT=5002
COLLECTOR_HOST=0.0.0.0
REDDIT_USER_AGENT=agentic-collector/0.1

# =============================================================================
# MCP Orchestrator
# =============================================================================
ORCHESTRATOR_PORT=5003
ORCHESTRATOR_HOST=0.0.0.0

# OpenAI API provider (primary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# CLI providers (optional fallback — require host CLI login + volume mounts)
CODEX_PATH=/usr/local/bin/codex
CLAUDE_PATH=/usr/local/bin/claude
GEMINI_PATH=/usr/local/bin/gemini

# Comma-separated default providers: openai, codex, claude, gemini
DEFAULT_PROVIDERS=openai
PROVIDER_TIMEOUT_MS=60000
