REPORT_TIMEZONE=Asia/Seoul

# Analysis backend
ANALYSIS_BACKEND=orchestrator
COLLECTOR_BASE_URL=http://collector:5002
ORCHESTRATOR_BASE_URL=http://mcp-orchestrator:5003
