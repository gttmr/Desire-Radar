# =============================================================================
# Collector
# =============================================================================
COLLECTOR_PORT=5002
COLLECTOR_HOST=0.0.0.0
REDDIT_USER_AGENT=agentic-collector/0.1
NAVER_CLIENT_ID=wi8xOeptEfhzNm4GxQQR
NAVER_CLIENT_SECRET=sAG3nNP507
APP_STORE_API_KEY=
SIMILARWEB_API_KEY=
TIKTOK_API_KEY=
LLM_ANALYSIS_ENABLED=true
LLM_ANALYSIS_EXECUTION_MODE=batch
LLM_ANALYSIS_BATCH_SIZE=3
LLM_CLI_EXEC_PATH=codex
LLM_CLI_PROVIDER=codex
LLM_CLI_INITIAL_ARGS=exec --skip-git-repo-check --ephemeral -C /tmp -s read-only --json
LLM_CLI_RESUME_ARGS=exec resume --skip-git-repo-check --json
LLM_CLI_USE_STDIN=true
LLM_CLI_MODEL_FLAG=-m
LLM_DEFAULT_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_CHAR_BUDGET=6000
LLM_BATCH_CHAR_BUDGET=7000
LLM_MAX_EVIDENCE_PER_TASK=8
LLM_PROMPT_TITLE_MAX_CHARS=120
LLM_PROMPT_INCLUDE_PREVIOUS_ANALYSIS=true
LLM_BATCH_INCLUDE_PREVIOUS_ANALYSIS=true
LLM_PROMPT_INCLUDE_METRICS=auto
LLM_PROMPT_INCLUDE_URLS=false
LLM_PROMPT_INCLUDE_GEO=false
LLM_PROMPT_INCLUDE_EVIDENCE_IDS=false
LLM_SESSION_MEMORY_ENTRY_COUNT=3
LLM_SESSION_MEMORY_ENTRY_CHAR_BUDGET=160
LLM_SESSION_MAX_IDLE_MINUTES=20
LLM_SESSION_MAX_TURNS=5
LLM_SESSION_MAX_UNCACHED_INPUT_TOKENS=20000
LLM_HUMAN_ROUTING_ENABLED=true
LLM_HUMAN_ROUTING_EXECUTION_MODE=fresh
LLM_HUMAN_ROUTING_MODEL=gpt-5.4-mini
LLM_HUMAN_ROUTING_SESSION_DOMAIN=human-input-routing
LLM_HUMAN_ROUTING_AUTO_THRESHOLD=0.75
LLM_HUMAN_ROUTING_REVIEW_THRESHOLD=0.45
LLM_HUMAN_ROUTING_MAX_INPUT_CHARS=4000
LLM_SESSION_WORKDIR_ROOT=data/llm-session-workdirs
LLM_SOURCE_AGENT_ENABLED=true
LLM_SOURCE_AGENT_EXECUTION_MODE=resume
LLM_SOURCE_AGENT_MAX_INPUT_CHARS=8000

# =============================================================================
# MCP Orchestrator
# =============================================================================
ORCHESTRATOR_PORT=5003
ORCHESTRATOR_HOST=0.0.0.0

# OpenAI API provider (optional; only used when you explicitly include openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# CLI providers (default runtime path — require host CLI login + volume mounts)
CODEX_PATH=/usr/local/bin/codex
CLAUDE_PATH=/usr/local/bin/claude
GEMINI_PATH=/usr/local/bin/gemini
CODEX_TRANSPORT=cli_exec
CLAUDE_TRANSPORT=cli_exec
GEMINI_TRANSPORT=cli_exec
PROVIDER_EXTERNAL_POLL_INTERVAL_MS=1000
PROVIDER_SESSION_ROOT_DIR=data/provider-sessions

# ENABLED_PROVIDERS controls registration + health monitoring in this runtime.
# DEFAULT_PROVIDERS controls run-time preference among the enabled providers.
ENABLED_PROVIDERS=codex,claude,gemini
DEFAULT_PROVIDERS=codex,claude,gemini
PROVIDER_TIMEOUT_MS=60000
PROVIDER_HEALTH_POLL_INTERVAL_SEC=300
PROVIDER_REPAIR_COOLDOWN_SEC=1800
# Optional repair commands. Orchestrator only runs these on auth/login-style failures.
# Examples:
#   PROVIDER_REPAIR_CODEX_COMMAND=printenv OPENAI_API_KEY | codex login --with-api-key
#   PROVIDER_REPAIR_CLAUDE_COMMAND=claude auth login --claudeai
# Gemini CLI does not expose a separate auth status/login subcommand in this environment,
# so leave it empty unless you provide your own wrapper.
PROVIDER_REPAIR_CODEX_COMMAND=
PROVIDER_REPAIR_CLAUDE_COMMAND=
PROVIDER_REPAIR_GEMINI_COMMAND=
